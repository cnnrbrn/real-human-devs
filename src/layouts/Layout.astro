---
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/barlow/600.css";
import "@fontsource/kalam/400.css";
import "@fontsource/kalam/700.css";
import "../styles/globals.css";
// the hero h1's face, preloaded so the headline doesn't swap in late
import kalamBold from "@fontsource/kalam/files/kalam-latin-700-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Share image under public/, 1200×630. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  /** Keep the page out of search results, and drop its canonical/og:url. */
  noindex?: boolean;
  /** Extra schema.org data for this page, beside the site-wide Organization. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = "Real Human Devs | Web, app, WordPress & Shopify development",
  description = "A small studio of senior developers and designers. We build web apps, mobile apps, WordPress sites and online shops on Shopify, WooCommerce or custom code.",
  image = "/og/default.png",
  imageAlt = "Real Human Devs: Tired of talking to AI? Talk to us. Web apps, mobile apps, WordPress and online shops.",
  type = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

// Always the live domain (astro.config `site`), so previews shared from
// dev.realhumandevs.com still point people at the real site.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const organization = {
  "@type": "Organization",
  "@id": new URL("/#organization", Astro.site).href,
  name: "Real Human Devs",
  url: new URL("/", Astro.site).href,
  logo: new URL("/apple-icon.png", Astro.site).href,
  email: "hello@realhumandevs.com",
  knowsAbout: [
    "Web app development",
    "Mobile app development",
    "WordPress development",
    "Shopify development",
    "WooCommerce development",
    "E-commerce",
  ],
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": jsonLd ? [organization, jsonLd] : [organization],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f9f3e6" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Real Human Devs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />
    {/* X reads og:title/description/image; it only needs the card type */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link
      rel="preload"
      href={kalamBold}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    {/* Runs before first paint so the page never flashes the wrong theme.
        is:inline keeps Astro from bundling/deferring it. Mirrors applyTheme()
        in components/theme-toggle.tsx — keep the two in step. */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.style.colorScheme = dark ? "dark" : "light";
          if (dark) {
            document
              .querySelector('meta[name="theme-color"]')
              .setAttribute("content", "#16181d");
          }
        } catch {
          /* storage blocked — fall back to the light default */
        }
      })();
    </script>
    <link
      rel="icon"
      href="/favicon-light.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/favicon-dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    {/* Umami analytics. data-domains makes the tracker ignore every host but
        the live one, so dev.realhumandevs.com and localhost aren't counted. */}
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="dda6738f-14a0-420a-9b9e-88592e2cebd4"
      data-domains="realhumandevs.com,www.realhumandevs.com"
    ></script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <slot />
  </body>
</html>
