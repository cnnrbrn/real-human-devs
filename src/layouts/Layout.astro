---
import '@fontsource/barlow/400.css'
import '@fontsource/barlow/500.css'
import '@fontsource/barlow/600.css'
import '@fontsource/kalam/400.css'
import '@fontsource/kalam/700.css'
import '../styles/globals.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Real Human Devs | Web, app and WordPress development',
  description = 'A small studio of senior designers and developers. We build web apps, mobile apps and custom WordPress sites, and you work with the same people from start to finish.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f9f3e6" />

    {/* Runs before first paint so the page never flashes the wrong theme.
        is:inline keeps Astro from bundling/deferring it. Mirrors applyTheme()
        in components/theme-toggle.tsx — keep the two in step. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme')
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.classList.toggle('dark', dark)
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
          if (dark) {
            document
              .querySelector('meta[name="theme-color"]')
              .setAttribute('content', '#16181d')
          }
        } catch (e) {
          /* storage blocked — fall back to the light default */
        }
      })()
    </script>

    <link
      rel="icon"
      href="/favicon-light.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/favicon-dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    {/* Umami analytics. data-domains makes the tracker ignore every host but
        the live one, so dev.realhumandevs.com and localhost aren't counted. */}
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="dda6738f-14a0-420a-9b9e-88592e2cebd4"
      data-domains="realhumandevs.com,www.realhumandevs.com"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
