---
// Pages serves dist/404.html, with a 404 status, for any path it can't match
import Layout from '../layouts/Layout.astro'
import { SiteNav } from '../components/site-nav'
import { SiteFooter } from '../components/site-footer'
import { UnevenButton } from '../components/uneven-button'
---

<Layout title="Page not found | Real Human Devs" noindex>
  <SiteNav client:load current="none" />
  <main id="main">
    <section class="border-b-[1.5px] border-line bg-[radial-gradient(var(--dot)_1px,transparent_1.2px)] bg-size-[26px_26px]">
      <div class="container-page flex flex-col items-start gap-6 pt-22 pb-26">
        <p class="kicker">404</p>
        <h1 class="font-hand text-[clamp(52px,7.4vw,92px)] leading-[0.98] font-bold tracking-[-0.01em] text-balance">
          This page doesn't exist.
        </h1>
        <p class="max-w-[40ch] text-[21px] leading-[1.55] text-pretty text-muted">
          The link may be out of date, or the address mistyped.
        </p>
        <UnevenButton
          href="/"
          size="lg"
          rotate={-0.8}
          radius="5px 12px 6px 14px / 14px 6px 12px 5px"
          className="mt-2"
        >
          Back to the homepage
        </UnevenButton>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
